# Base URL of the API. Leave as /api: the dev server (vite.config.js proxy) and Vercel (vercel.mjs
# rewrite) forward /api to the backend, so the browser stays on one origin and the secure session
# cookie works. Change only for unusual setups.
VITE_API_URL=/api

# Production only (Vercel): the backend's address, e.g. https://your-backend.vercel.app
# vercel.mjs forwards /api to it at build time. Local development uses the Vite proxy instead
# (http://localhost:5000, or VITE_DEV_API_TARGET).
API_PROXY_TARGET=
