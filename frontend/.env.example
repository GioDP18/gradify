# Base URL of the API. Leave as /api: the dev server (vite.config.js proxy) and Vercel (vercel.json
# rewrite) forward /api to the backend, so the browser stays on one origin and the secure session
# cookie works. Change only for unusual setups.
VITE_API_URL=/api

# Production only (Vercel): the backend's address, e.g. https://your-backend.vercel.app
# vercel.json forwards /api to it ("$API_PROXY_TARGET"). Local development uses the Vite proxy instead
# (http://localhost:5000, or VITE_DEV_API_TARGET).
API_PROXY_TARGET=

# Support chat (the Noupe AI assistant), opened by "Contact support" on the sign-in page. Optional:
# the app already has its assistant built in (src/utils/supportChat.js). Set this only to use
# another one (https://www.noupe.com/agent/<agent id>), or set it to nothing to turn the chat off.
# VITE_SUPPORT_CHAT_URL=
