# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Number of reverse proxies in front of the API. Vercel / Render / Nginx: 1. Local development: 0.
# Required in production (the server refuses to start without it).
TRUST_PROXY=0

# ── Database ────────────────────────────────────────────
# Local single-node replica set:  mongodb://127.0.0.1:27017/?replicaSet=rs0
# MongoDB Atlas:                  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DB_NAME=evsu_grading_system
# Optional. Comma-separated DNS server IPs used to resolve mongodb+srv:// hosts.
# Set this only if startup fails with "querySrv ECONNREFUSED" (a known Node-on-Windows issue), e.g. 8.8.8.8,1.1.1.1
DNS_SERVERS=

# ── Authentication ──────────────────────────────────────
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters and different from each other.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7
JWT_REFRESH_REMEMBER_DAYS=30
BCRYPT_ROUNDS=12
# true in production (HTTPS). false only for local http development.
COOKIE_SECURE=false

# ── Client ──────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CLIENT_URL=http://localhost:5173

# ── Locale ──────────────────────────────────────────────
APP_TIMEZONE=Asia/Manila

# ── Scheduled maintenance (Vercel Cron) ─────────────────
# Random string of at least 32 characters. Vercel sends it to /api/internal/sweep daily.
# Leave empty to disable the endpoint (e.g. local development; the server runs its own sweep).
CRON_SECRET=

# ── First-run seeding ───────────────────────────────────
# true: when the API starts on an EMPTY database (no accounts yet), create the collections,
# indexes and the administrator below. Does nothing once an account exists. Unset or false: never.
SEED_DATABASE=false
# Required when SEED_DATABASE=true. Sign in with these, then change the password in Profile.
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=
# Optional sign-in name (3–40 letters, numbers, dots, dashes, underscores).
SEED_ADMIN_USERNAME=
# At least 12 characters, with upper- and lowercase letters, a number, and a symbol.
SEED_ADMIN_PASSWORD=

# ── Login protection ────────────────────────────────────
# Failed logins allowed per client IP per 15 minutes (per-account limits always apply). 0 = disabled.
LOGIN_IP_RATE_LIMIT=50

# ── QR self-enrollment protection ───────────────────────
# Enrollment submissions allowed per client IP per class link per 15 minutes. A whole class often
# shares one campus IP, so keep this above your largest class size. 0 = disabled.
SELF_ENROLL_IP_LIMIT=150

# ── Audit-log retention (days; 0 = keep forever) ────────
# Applied by the scheduled sweep. Set these to match the school's records policy.
# IP address and browser details are removed from audit entries older than this:
AUDIT_IP_RETENTION_DAYS=90
# Routine entries (sign-ins, sign-outs, automatic recalculations) are deleted after this:
AUDIT_ROUTINE_RETENTION_DAYS=365
# All other entries (score, attendance, enrollment, criteria changes; security events) after this:
AUDIT_RETENTION_DAYS=1825
